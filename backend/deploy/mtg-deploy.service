# Oneshot deploy: pull latest main and rebuild the container if it moved.
# Driven by mtg-deploy.timer. Logs to journald (journalctl -u mtg-deploy).
#
# Install:
#   sudo cp deploy/mtg-deploy.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mtg-deploy.timer
#
# Adjust User= / WorkingDirectory= / ExecStart= if your checkout lives
# somewhere other than /home/user/mtg-scanner-backend.
[Unit]
Description=Pull latest mtg-scanner-backend and rebuild the container
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=haziq
WorkingDirectory=/home/user/mtg-scanner-backend
ExecStart=/home/user/mtg-scanner-backend/deploy.sh

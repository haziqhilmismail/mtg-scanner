GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SQLite default — file lives at backend/data/app.db
# Swap to a postgres URL when going multi-user:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Solo-mode owner. When GOOGLE_CLIENT_ID below is empty, every API call is
# attributed to this user_id (no login required — handy for local dev). Once
# GOOGLE_CLIENT_ID is set, the first Google sign-in claims this user row.
SOLO_USER_ID=1

# Google sign-in. Get one from https://console.cloud.google.com/apis/credentials
# → "Create OAuth client ID" → Web application. Leave empty to keep solo mode.
GOOGLE_CLIENT_ID=

# Optional: restrict who can sign in. Comma-separated allowlist of emails.
# Empty = anyone with a Google account can sign in (new users get fresh rows).
ALLOWED_EMAILS=

# Optional: secret used to sign our own session tokens. Auto-generated and
# persisted to data/jwt_secret.txt on first run if left blank.
JWT_SECRET=

# CORS — comma-separated list of allowed frontend origins. Localhost dev URLs
# are included by default. In production set this to your Vercel URL, e.g.:
#   CORS_ORIGINS=https://mtg-scanner.vercel.app
# (Multiple values: CORS_ORIGINS=https://a.vercel.app,https://b.vercel.app)
CORS_ORIGINS=

# Optional: offline card identification via perceptual hashing. When true and
# data/phash_index.npz exists, /api/scan tries to name each cropped card
# locally; only unconfident crops fall back to Gemini. Build the index first:
#   python scripts/build_phash_index.py
# USE_LOCAL_CARD_ID=true
# PHASH_DISTANCE_THRESHOLD=12  # tighter = fewer false matches, more Gemini calls

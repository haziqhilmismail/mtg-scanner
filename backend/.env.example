# Gemini reads the comment screenshots on the Claims page, and names the cards
# in photos unless SCANNER_BACKEND=local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Which pipeline /api/scan runs. "gemini" (default) or "local" — the
# offline scanner that production runs (detector + embeddings + collector-line
# OCR, no API key). "local" needs `pip install -r requirements-local-scanner.txt`
# (the Docker image has it) plus three files under data/ — see README
# "Local scanner".
# SCANNER_BACKEND=local

# SQLite — the file lives at backend/data/app.db
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Solo-mode owner. When GOOGLE_CLIENT_ID below is empty, every API call is
# attributed to this user_id (no login required — handy for local dev). Once
# GOOGLE_CLIENT_ID is set, the first Google sign-in claims this user row.
SOLO_USER_ID=1

# Google sign-in. Get one from https://console.cloud.google.com/apis/credentials
# → "Create OAuth client ID" → Web application. Leave empty to keep solo mode.
GOOGLE_CLIENT_ID=

# Optional: restrict who can sign in. Comma-separated allowlist of emails.
# Empty = anyone with a Google account can sign in (new users get fresh rows).
ALLOWED_EMAILS=

# Optional: secret used to sign our own session tokens. Auto-generated and
# persisted to data/jwt_secret.txt on first run if left blank.
JWT_SECRET=

# CORS — comma-separated list of allowed frontend origins. Localhost dev URLs
# are included by default. In production set this to the site's own domain,
# which calls the API cross-origin (see frontend/src/api/http.ts), e.g.:
#   CORS_ORIGINS=https://mtg.haziqhilmi.com
# (Multiple values: CORS_ORIGINS=https://a.example.com,https://b.example.com)
CORS_ORIGINS=

# Optional: shared secret for POST /api/refresh-ck. The nightly GitHub Action
# (.github/workflows/ck-refresh.yml) sends the REFRESH_CK_TOKEN repo secret as
# X-Refresh-Token. Empty = anyone can trigger a refresh.
REFRESH_CK_TOKEN=

# Optional: Telegram push when an unexpected backend or frontend bug fires.
# 1. DM @BotFather on Telegram → /newbot → grab the TOKEN.
# 2. DM the new bot once, then open:
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the chat.id of your message.
# Both blank = bugs still land in the `bug_events` table; no push is sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# BUG_NOTIFY_WINDOW_MINUTES=10  # same fingerprint within window pushes once

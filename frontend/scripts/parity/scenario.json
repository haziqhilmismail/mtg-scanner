[
  { "name": "auth config", "method": "GET", "path": "/api/auth/config" },
  { "name": "me", "method": "GET", "path": "/api/auth/me" },
  { "name": "save default pricing", "method": "PUT", "path": "/api/auth/me/pricing", "json": { "pricing": { "multNormal": 2.8, "multFoil": 3, "currencyLabel": "RM", "labelPosition": "center", "showOutlines": false, "showCurrency": true, "showCents": false, "roundDirection": "up", "roundStep": 1, "minPrice": 1, "foilStyle": "suffix", "labelFontScale": 1, "priceMode": "photo" } } },
  { "name": "seller name", "method": "PUT", "path": "/api/auth/me/seller-name", "json": { "seller_name": "Ali" } },
  { "name": "health", "method": "GET", "path": "/api/health" },
  { "name": "credits", "method": "GET", "path": "/api/credits" },
  { "name": "payment", "method": "GET", "path": "/api/payment" },
  { "name": "save payment", "method": "PUT", "path": "/api/payment", "json": { "bank_name": "Maybank", "bank_account_number": "1234", "bank_account_holder": "Ali", "payment_note": "" } },
  { "name": "delete payment QR", "method": "DELETE", "path": "/api/payment/qr" },
  { "name": "new post", "method": "POST", "path": "/api/posts", "form": { "title": "Friday", "pricing": "{\"multNormal\":2.5,\"multFoil\":2.8,\"currencyLabel\":\"RM\",\"labelPosition\":\"center\",\"showOutlines\":false,\"showCurrency\":true,\"showCents\":false,\"roundDirection\":\"up\",\"roundStep\":1,\"minPrice\":1,\"foilStyle\":\"suffix\",\"labelFontScale\":1,\"priceMode\":\"photo\"}" }, "save": { "post": "id" } },
  { "name": "rename post", "method": "PATCH", "path": "/api/posts/{post}", "json": { "title": "Friday post" } },
  { "name": "posts", "method": "GET", "path": "/api/posts?include_archived=true" },
  { "name": "scan a photo", "method": "POST", "path": "/api/scan", "form": { "post_id": "{post}" }, "image": true, "save": { "scan": "scan_id", "card": "cards.0.id", "bbox": "cards.0.bbox" } },
  { "name": "saved scans", "method": "GET", "path": "/api/scans?lite=1&limit=500" },
  { "name": "save scan state", "method": "PATCH", "path": "/api/scans/{scan}/state", "json": { "state": { "isFoil": [false], "priceOverride": [null], "quantity": [1], "multOverride": [null], "removed": [false], "sold": [false], "pillOffset": [null], "versionOk": [false], "picks": [null], "locked": [null], "lockedAt": null, "rev": 1 } } },
  { "name": "card correction", "method": "PUT", "path": "/api/scans/{scan}/cards/{card}/correction", "json": { "scryfall_id": "0d3f4b1c-1111-4222-8333-444455556666", "kind": "confirm" } },
  { "name": "frame a card", "method": "POST", "path": "/api/scans/{scan}/frame-card", "form": { "payload": "{\"corners\":[[200,100],[260,100],[260,184],[200,184]]}" } },
  { "name": "refresh prices", "method": "POST", "path": "/api/scans/{scan}/relookup-prices" },
  { "name": "find a card", "method": "POST", "path": "/api/relookup", "form": { "payload": "{\"name\":\"Sol Ring\",\"set\":\"\"}" } },
  { "name": "printings", "method": "POST", "path": "/api/printings", "form": { "payload": "{\"name\":\"Sol Ring\"}" } },
  { "name": "photo order", "method": "PUT", "path": "/api/scans/order", "json": { "scan_ids": ["{scan}"] } },
  { "name": "add card to post", "method": "POST", "path": "/api/listings", "json": { "name": "Sol Ring", "unit_price_myr": "3.00", "qty_total": 1, "scan_id": "{scan}", "bbox": "{bbox}", "post_ids": ["{post}"] }, "save": { "listing": "id" } },
  { "name": "listings", "method": "GET", "path": "/api/listings?status=active" },
  { "name": "edit listing", "method": "PATCH", "path": "/api/listings/{listing}", "json": { "unit_price_myr": "4.00" } },
  { "name": "save claims", "method": "POST", "path": "/api/claims/confirm", "json": { "post_id": "{post}", "claims": [{ "buyer": "Aina", "items": [{ "scan_id": "{scan}", "card_id": "{card}", "bbox": "{bbox}", "name": "Sol Ring", "is_foil": false, "unit_price_myr": "4.00", "qty_total": 1, "qty": 1 }] }] } },
  { "name": "orders", "method": "GET", "path": "/api/orders", "save": { "order": "0.id", "buyer": "0.buyer_id", "item": "0.items.0.id" } },
  { "name": "buyers", "method": "GET", "path": "/api/buyers" },
  { "name": "buyer phone", "method": "PATCH", "path": "/api/buyers/{buyer}", "json": { "phone": "0123456789" } },
  { "name": "mark paid", "method": "PATCH", "path": "/api/orders/{order}", "json": { "paid_at": "2026-11-01T10:00:00" } },
  { "name": "send prices", "method": "PUT", "path": "/api/orders/{order}/prices", "json": { "items": [{ "id": "{item}", "unit_price_myr": "5.00" }], "sent": true } },
  { "name": "unsend prices", "method": "DELETE", "path": "/api/orders/{order}/prices-sent" },
  { "name": "record sale", "method": "POST", "path": "/api/sales", "json": { "channel": "copy", "post_id": "{post}", "post_type": "photo", "lines": [{ "order_item_id": "{item}", "app_usd": null, "app_mult": null, "price_kind": null }] } },
  { "name": "delete claimed post", "method": "DELETE", "path": "/api/posts/{post}" },
  { "name": "cancel order", "method": "POST", "path": "/api/orders/{order}/cancel" },
  { "name": "restore order", "method": "POST", "path": "/api/orders/{order}/restore" },
  { "name": "posts with claims", "method": "GET", "path": "/api/posts?include_archived=true" },
  { "name": "orders with archived", "method": "GET", "path": "/api/orders?include_archived=true" },
  { "name": "repost", "method": "POST", "path": "/api/posts/{post}/repost", "json": { "title": "Again", "new_prices": true, "photos": [{ "scan_id": "{scan}", "state": { "isFoil": [false], "priceOverride": [null], "quantity": [1], "multOverride": [null], "removed": [false], "sold": [false], "pillOffset": [null], "versionOk": [false], "locked": [null], "lockedAt": null } }] } },
  { "name": "unfile photo", "method": "POST", "path": "/api/scans/move", "json": { "scan_ids": ["{scan}"], "post_id": null } },
  { "name": "take card out", "method": "DELETE", "path": "/api/listings/{listing}" },
  { "name": "delete photo", "method": "DELETE", "path": "/api/scans/{scan}" },
  { "name": "scans after delete", "method": "GET", "path": "/api/scans?lite=1&limit=500" }
]
